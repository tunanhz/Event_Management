{
  "name": "event-management-backend",
  "version": "1.0.0",
  "description": "Event Management Backend - Express.js with Modular Monolith Architecture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "seed:admin": "tsx src/scripts/create-admin.ts",
    "seed:homepage": "tsx src/scripts/seed-homepage.ts",
    "seed:events": "tsx src/scripts/seed-organizer-events.ts",
    "seed:admin-demo": "tsx src/scripts/seed-admin-demo.ts",
    "seed:registrations": "tsx src/scripts/seed-registrations.ts",
    "seed:staff-checkin": "tsx src/scripts/seed-staff-checkin-demo.ts",
    "cleanup:qa": "tsx src/scripts/cleanup-qa-events.ts",
